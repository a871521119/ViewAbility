<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ViewAbility">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ViewAbility"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SingleViewActivity"
            android:label="单个 View 曝光检测" />
        <activity
            android:name=".ListItemActivity"
            android:label="列表指定 Item 曝光检测" />
        <activity
            android:name=".ScrollChildActivity"
            android:label="Scroll 子 View 曝光检测" />
        <activity
            android:name=".MultiViewActivity"
            android:label="多个 View 同时曝光检测" />
    </application>

</manifest>
